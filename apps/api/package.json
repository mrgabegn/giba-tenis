{
  "name": "@giba-quadra/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --import tsx --watch src/dev-server.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "calendar:configure": "node --env-file-if-exists=.env --import tsx scripts/configure-calendar.ts",
    "calendar:access": "node --env-file-if-exists=.env --import tsx scripts/create-calendar-access.ts",
    "db:check": "node --env-file-if-exists=.env --import tsx scripts/check-database.ts"
  },
  "dependencies": {
    "@giba-quadra/contracts": "0.1.0",
    "mongodb": "^7.0.0"
  }
}
