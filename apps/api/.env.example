# Somente no servidor. Nunca use prefixo EXPO_PUBLIC_ nestas variaveis.
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DATABASE=giba_quadra_dev
PORT=3000
# Gere um valor aleatorio: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Sem token configurado, /api/readiness permanece desabilitado (503).
READINESS_TOKEN=
