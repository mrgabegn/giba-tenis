{
  "name": "giba-tenis",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "engines": {
    "node": "24.x",
    "npm": ">=11"
  },
  "packageManager": "npm@11.9.0",
  "scripts": {
    "dev:mobile": "npm run start --workspace @giba-tenis/mobile",
    "dev:api": "npm run dev --workspace @giba-tenis/api",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspace @giba-tenis/api",
    "check": "npm run typecheck && npm test && npm run format:check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "db:check": "npm run db:check --workspace @giba-tenis/api",
    "export:android": "npm run export:android --workspace @giba-tenis/mobile",
    "export:ios": "npm run export:ios --workspace @giba-tenis/mobile"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "prettier": "^3.6.0",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3"
  }
}
